{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-data-nexus.dev/contracts/v0/result-manifest.schema.json",
  "title": "Committed Result Manifest v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "manifest_id", "run_id", "format", "row_count",
    "byte_count", "parts", "committed_at", "committed"
  ],
  "properties": {
    "contract_version": { "const": "result-manifest/v0" },
    "manifest_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "format": { "enum": ["parquet", "json"] },
    "row_count": { "type": "integer", "minimum": 0 },
    "byte_count": { "type": "integer", "minimum": 0 },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uri", "sha256"],
        "properties": {
          "uri": { "type": "string", "minLength": 1 },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "committed_at": { "type": "string", "format": "date-time" },
    "committed": { "const": true }
  }
}
