{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-data-nexus.dev/contracts/v0/ontology.schema.json",
  "title": "Ontology Contract v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "ontology_id", "version", "entities"],
  "properties": {
    "contract_version": { "const": "ontology/v0" },
    "ontology_id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/id" },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entity" }
    },
    "metrics": {
      "type": "array",
      "items": { "$ref": "#/$defs/metric" },
      "default": []
    },
    "relations": {
      "type": "array",
      "items": { "$ref": "#/$defs/relation" },
      "default": []
    },
    "resolvers": {
      "type": "array",
      "items": { "$ref": "#/$defs/resolver" },
      "default": []
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\r\\n])[A-Za-z][A-Za-z0-9_.-]*$"
    },
    "dataType": {
      "enum": ["string", "integer", "number", "decimal", "boolean", "date", "datetime"]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "data_type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "data_type": { "$ref": "#/$defs/dataType" },
        "nullable": { "type": "boolean", "default": true },
        "description": { "type": ["string", "null"] }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fields"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "type": ["string", "null"] },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/field" }
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entity", "field", "aggregation"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "entity": { "$ref": "#/$defs/id" },
        "field": { "$ref": "#/$defs/id" },
        "aggregation": {
          "enum": ["SUM", "AVG", "MIN", "MAX", "COUNT", "COUNT_DISTINCT"]
        },
        "description": { "type": ["string", "null"] }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "left_entity", "right_entity", "left_field", "right_field", "cardinality"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "left_entity": { "$ref": "#/$defs/id" },
        "right_entity": { "$ref": "#/$defs/id" },
        "left_field": { "$ref": "#/$defs/id" },
        "right_field": { "$ref": "#/$defs/id" },
        "cardinality": {
          "enum": ["one_to_one", "one_to_many", "many_to_one", "many_to_many"]
        }
      }
    },
    "resolver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entity", "field", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "entity": { "$ref": "#/$defs/id" },
        "field": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["static", "search", "databricks"] }
      }
    }
  }
}
