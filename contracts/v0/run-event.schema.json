{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-data-nexus.dev/contracts/v0/run-event.schema.json",
  "title": "Run Event v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "run_id", "sequence", "event_type", "emitted_at", "payload"],
  "properties": {
    "contract_version": { "const": "run-event/v0" },
    "run_id": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 0 },
    "event_type": {
      "enum": [
        "run.created", "run.started", "run.succeeded", "run.failed", "run.cancelled",
        "stage.started", "stage.succeeded", "stage.failed",
        "node.started", "node.succeeded", "node.failed"
      ]
    },
    "emitted_at": { "type": "string", "format": "date-time" },
    "stage_id": { "type": ["string", "null"] },
    "node_id": { "type": ["string", "null"] },
    "payload": { "type": "object" }
  }
}

