{
  "$defs": {
    "ResourceVersion": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "resource-version/v1",
          "default": "resource-version/v1",
          "title": "Contract Version",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "resource_kind": {
          "const": "ontology",
          "default": "ontology",
          "title": "Resource Kind",
          "type": "string"
        },
        "resource_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Resource Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Sha256",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "resource_id",
        "revision",
        "content_sha256"
      ],
      "title": "ResourceVersion",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Tenant Id",
          "type": "string"
        },
        "workspace_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "workspace_id"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "catalog-compile/v1",
      "title": "Contract Version",
      "type": "string"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Request Id",
      "type": "string"
    },
    "catalog": {
      "$ref": "#/$defs/ResourceVersion"
    },
    "question": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Question",
      "type": "string"
    }
  },
  "required": [
    "contract_version",
    "request_id",
    "catalog",
    "question"
  ],
  "title": "CatalogCompileRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semantic-data-nexus:compiler:request:v1"
}
