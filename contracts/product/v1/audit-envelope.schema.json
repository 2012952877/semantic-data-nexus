{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semantic-data-nexus:product:audit-envelope:v1",
  "description": "Append-only, metadata-only audit record. Append authorization and immutability require a storage adapter.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "operation", "event_id", "stream_id", "sequence", "previous_event_id", "recorded_at", "scope", "actor", "authorization_ref", "resource", "action", "outcome", "trace_id"],
  "properties": {
    "contract_version": {"const": "audit-envelope/v1"},
    "operation": {"const": "append"},
    "event_id": {"$ref": "urn:semantic-data-nexus:product:common:v1#/$defs/id"},
    "stream_id": {"$ref": "urn:semantic-data-nexus:product:common:v1#/$defs/id"},
    "sequence": {"type": "integer", "minimum": 1},
    "previous_event_id": {"anyOf": [{"$ref": "urn:semantic-data-nexus:product:common:v1#/$defs/id"}, {"type": "null"}]},
    "recorded_at": {"$ref": "urn:semantic-data-nexus:product:common:v1#/$defs/timestamp"},
    "scope": {"$ref": "urn:semantic-data-nexus:product:common:v1#/$defs/scope"},
    "actor": {"$ref": "urn:semantic-data-nexus:product:common:v1#/$defs/principal"},
    "authorization_ref": {"$ref": "urn:semantic-data-nexus:product:common:v1#/$defs/id"},
    "resource": {"$ref": "urn:semantic-data-nexus:product:resource-version:v1"},
    "action": {"enum": ["create", "read", "publish", "retire", "grant", "revoke", "execute", "cancel", "export"]},
    "outcome": {"enum": ["allowed", "denied", "failed"]},
    "trace_id": {"$ref": "urn:semantic-data-nexus:product:common:v1#/$defs/id"}
  },
  "allOf": [{
    "if": {"properties": {"sequence": {"const": 1}}},
    "then": {"properties": {"previous_event_id": {"type": "null"}}},
    "else": {"properties": {"previous_event_id": {"type": "string"}}}
  }]
}
