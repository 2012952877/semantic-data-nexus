{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semantic-data-nexus:product:resource-version:v1",
  "description": "Immutable content identity within a scope; revision is not a mutable display name.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "scope", "resource_kind", "resource_id", "revision", "content_sha256"],
  "properties": {
    "contract_version": {"const": "resource-version/v1"},
    "scope": {"$ref": "urn:semantic-data-nexus:product:common:v1#/$defs/scope"},
    "resource_kind": {"enum": ["ontology", "knowledge-base", "resolver", "credential-reference", "llm", "prompt-template", "compute-engine", "result-store", "run", "dataset", "user", "group", "workspace", "policy"]},
    "resource_id": {"$ref": "urn:semantic-data-nexus:product:common:v1#/$defs/id"},
    "revision": {"type": "integer", "minimum": 1},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}(?![\\s\\S])"}
  }
}
