{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semantic-data-nexus:product:trusted-context:v1",
  "description": "Server-produced authorization context. A valid JSON shape is not proof of identity or membership.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "scope", "principal", "authentication", "membership"],
  "properties": {
    "contract_version": {"const": "trusted-context/v1"},
    "scope": {"$ref": "urn:semantic-data-nexus:product:common:v1#/$defs/scope"},
    "principal": {"$ref": "urn:semantic-data-nexus:product:common:v1#/$defs/principal"},
    "authentication": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "audience", "authenticated_at", "expires_at"],
      "properties": {
        "method": {"const": "oidc"},
        "audience": {"type": "string", "minLength": 1, "maxLength": 256},
        "authenticated_at": {"$ref": "urn:semantic-data-nexus:product:common:v1#/$defs/timestamp"},
        "expires_at": {"$ref": "urn:semantic-data-nexus:product:common:v1#/$defs/timestamp"}
      }
    },
    "membership": {
      "description": "The authoritative membership resolved for this exact scope and principal; never copied from a caller header.",
      "type": "object", "additionalProperties": false,
      "required": ["membership_id", "revision", "authorized_at", "permissions"],
      "properties": {
        "membership_id": {"$ref": "urn:semantic-data-nexus:product:common:v1#/$defs/id"},
        "revision": {"type": "integer", "minimum": 1},
        "authorized_at": {"$ref": "urn:semantic-data-nexus:product:common:v1#/$defs/timestamp"},
        "permissions": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "urn:semantic-data-nexus:product:common:v1#/$defs/id"}
        }
      }
    }
  }
}
