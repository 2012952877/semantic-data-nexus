{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semantic-data-nexus:product:capability-registry:v1",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "baseline", "sources", "evidence", "capabilities"],
  "properties": {
    "contract_version": {"const": "capability-registry/v1"},
    "baseline": {
      "type": "object", "additionalProperties": false,
      "required": ["release", "commit", "parent_issue"],
      "properties": {
        "release": {"const": "v0.1.0"},
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}(?![\\s\\S])"},
        "parent_issue": {"const": 28}
      }
    },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "summary", "limitations"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "kind": {"enum": ["sanitized-observation", "product-requirement", "repository"]},
          "summary": {"$ref": "#/$defs/text"},
          "limitations": {"$ref": "#/$defs/text"}
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "ref", "scope"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "kind": {"enum": ["implementation", "test", "integration", "verification"]},
          "ref": {"$ref": "#/$defs/text"},
          "scope": {"$ref": "#/$defs/text"},
          "run": {"$ref": "#/$defs/runEvidence"}
        },
        "allOf": [{
          "if": {"properties": {"kind": {"enum": ["integration", "verification"]}}},
          "then": {"required": ["run"]}
        }]
      }
    },
    "capabilities": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "description", "category", "observed_source", "state", "current_gap", "dependencies", "owner_surface", "issue", "milestone", "acceptance", "evidence"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "description": {"$ref": "#/$defs/text"},
          "category": {"enum": ["standard-domain", "ask-mode", "operator", "foundation", "commercial", "integration"]},
          "observed_source": {
            "type": "object", "additionalProperties": false, "required": ["ref", "confidence"],
            "properties": {
              "ref": {"$ref": "#/$defs/id"},
              "confidence": {"enum": ["high", "medium", "unknown", "not-observed"]}
            }
          },
          "state": {"enum": ["planned", "implemented", "integrated", "verified", "unsupported"]},
          "current_gap": {"$ref": "#/$defs/text"},
          "dependencies": {"$ref": "#/$defs/ids"},
          "owner_surface": {"enum": ["contracts", "control-api", "semantic-api", "semantic-backend", "query-runtime", "connectors", "web", "operations"]},
          "issue": {"type": "integer", "minimum": 29, "maximum": 38},
          "milestone": {"enum": ["M1", "M2", "M3"]},
          "acceptance": {
            "type": "object", "additionalProperties": false, "required": ["positive", "negative", "integration"],
            "properties": {
              "positive": {"$ref": "#/$defs/case"},
              "negative": {"$ref": "#/$defs/case"},
              "integration": {"$ref": "#/$defs/case"}
            }
          },
          "evidence": {"$ref": "#/$defs/ids"},
          "execution_policy": {
            "type": "object", "additionalProperties": false,
            "required": ["tool_authorization", "implicit_writes"],
            "properties": {
              "tool_authorization": {"const": "explicit"},
              "implicit_writes": {"const": "deny"}
            }
          }
        },
        "allOf": [{
          "if": {"properties": {"id": {"const": "operator.act"}}},
          "then": {"required": ["execution_policy"]}
        }]
      }
    }
  },
  "$defs": {
    "runEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "command", "environment", "result", "recorded_at"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}(?![\\s\\S])"},
        "command": {"$ref": "#/$defs/text"},
        "environment": {"$ref": "#/$defs/text"},
        "result": {"const": "passed"},
        "recorded_at": {"$ref": "urn:semantic-data-nexus:product:common:v1#/$defs/timestamp"}
      }
    },
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*(?![\\s\\S])"},
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["scenario", "test_ref"],
      "properties": {
        "scenario": {"$ref": "#/$defs/text"},
        "test_ref": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]}
      }
    }
  }
}
