# Safe defaults for compose.yaml. Copying this file never enables a live resolver.
NEXUS_WEB_PORT=8080
SEMANTIC_NEXUS_FAKE_DELAY_MS=750

# Live Databricks values are intentionally blank. Set them in the current shell only
# when explicitly using compose.databricks.yaml with the databricks profile.
DATABRICKS_WORKSPACE_HOST=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=synthetic_demo
DATABRICKS_SCHEMA=analytics
DATABRICKS_TOKEN=
