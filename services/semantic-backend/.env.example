# Offline deterministic resolver is the default.
SEMANTIC_NEXUS_RESOLVER=fake
# Optional 0-5000 ms fake-source delay for deterministic cancellation demos.
SEMANTIC_NEXUS_FAKE_DELAY_MS=0

